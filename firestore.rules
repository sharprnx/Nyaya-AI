rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Phase 0: Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return request.auth.token.email_verified == true; }
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    // Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'createdAt', 'updatedAt']) 
        && data.keys().size() == 4
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidUserUpdate(diff) {
      return diff.affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && (!('displayName' in diff.affectedKeys()) || (incoming().displayName is string && incoming().displayName.size() > 0 && incoming().displayName.size() <= 100))
        && incoming().updatedAt == request.time
        && incoming().createdAt == existing().createdAt
        && incoming().email == existing().email;
    }

    function isValidSearch(data) {
      return data.keys().hasAll(['query']) 
        && data.keys().size() >= 1 && data.keys().size() <= 3
        && data.query is string && data.query.size() > 0 && data.query.size() <= 500
        && (!('responseSummary' in data.keys()) || (data.responseSummary is string && data.responseSummary.size() <= 5000))
        && data.createdAt == request.time;
    }

    function isValidBookmark(data) {
      return data.keys().hasAll(['title', 'description', 'category', 'createdAt'])
        && data.keys().size() >= 4 && data.keys().size() <= 5
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 1000
        && (!('content' in data.keys()) || (data.content is string && data.content.size() <= 20000))
        && data.category is string && data.category.size() > 0 && data.category.size() <= 50
        && data.createdAt == request.time;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId
        && isValidUser(incoming());
      allow update: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId
        && isValidUserUpdate(incoming().diff(existing()));
      allow delete: if false;

      // Searches Subcollection
      match /searches/{searchId} {
        allow get: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(searchId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId;
        allow create: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(searchId) && request.auth.uid == userId
          && isValidSearch(incoming())
          && exists(/databases/$(database)/documents/users/$(userId)); // User must exist to record a search
        allow update: if false; // searches are read-only record
        allow delete: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(searchId) && request.auth.uid == userId;
      }

      // Bookmarks Subcollection
      match /bookmarks/{bookmarkId} {
        allow get: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(bookmarkId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isVerified() && isValidId(userId) && request.auth.uid == userId;
        allow create: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(bookmarkId) && request.auth.uid == userId
          && isValidBookmark(incoming())
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if false; // simplified to delete+recreate or restrict for this implementation
        allow delete: if isSignedIn() && isVerified() && isValidId(userId) && isValidId(bookmarkId) && request.auth.uid == userId;
      }
    }
  }
}
